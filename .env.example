# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database -----------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
MONGODB_URI=mongodb://localhost:27017/campus_orbis

# --- Server ---------------------------------------------------------------
PORT=3000
# "production" enables secure (HTTPS-only) session cookies and strict CSP
# upgrade-insecure-requests. Leave unset for local HTTP development.
NODE_ENV=development

# --- Initial Super Admin (required on first run only — see README.md) -----
# Must be set the very first time the server starts against an empty
# database; ignored on every subsequent start. No default/predictable
# password is ever created.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# --- CORS (optional — only needed if the frontend is hosted on a different
# origin than this API; leave unset for the default same-origin deployment) -
# Comma-separated list of exact origins to allow with credentials, e.g.:
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# --- Judge0 (sandboxed code execution for Practice/Tests/Course lessons) --
JUDGE0_BASE_URL=
JUDGE0_API_HOST=
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
# Override only if your Judge0 instance maps JavaScript/Node.js to a
# non-default language id (63 works on every standard Judge0 CE build).
JUDGE0_JS_LANGUAGE_ID=

# --- OTP / SMS (Super Admin mobile-number verification) -------------------
# A random per-deployment string mixed into every OTP hash. Set this in
# production so stored OTP hashes can't be brute-forced offline even if the
# database were exposed.
OTP_PEPPER=
# SMS delivery — OTP mechanics (hashing, expiry, rate limiting, masking) all
# work without either of these set, but no OTP can actually be delivered
# until one of the two options below points at a real provider.
#
# Option 1: Twilio (checked first if all three are set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Option 2: any other provider with a simple JSON webhook (POST {to, message}
# with a Bearer token) — used only if the Twilio vars above are not set.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# --- Web Push notifications -------------------------------------------------
# If unset, a key pair is auto-generated into vapid-keys.json on first run
# (gitignored — fine for local development, not recommended for production;
# set these explicitly instead so redeploying doesn't invalidate every
# existing device subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Face-match verification threshold (optional tuning) -------------------
FACE_MATCH_THRESHOLD=
